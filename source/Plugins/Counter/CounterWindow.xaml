<metro:MetroWindow x:Class="Counter.CounterWindow"
				   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				   xmlns:metro="http://schemes.grabacr.net/winfx/2014/controls"
				   xmlns:kcvc="http://schemes.grabacr.net/winfx/2015/kancolleviewer/controls"
				   xmlns:counter="clr-namespace:Counter"
				   mc:Ignorable="d"
				   d:DataContext="{d:DesignInstance counter:CounterViewModel}"
				   Title="カウンター"
				   MinWidth="400" Width="800"
				   MinHeight="200" Height="430"
				   FontSize="12"
				   Background="{DynamicResource ThemeBrushKey}"
				   Foreground="{DynamicResource ActiveForegroundBrushKey}"
				   FontFamily="{DynamicResource DefaultFontFamilyKey}"
				   IsRestoringWindowPlacement="True"
				   SnapsToDevicePixels="True"
				   Topmost="{Binding IsTopMost, Mode=TwoWay}"
				   TextOptions.TextFormattingMode="Display">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- #region CaptionBar (FleetWindow.xaml と共通) -->
		<Border metro:MetroWindow.IsCaptionBar="True"
				Panel.ZIndex="100">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<kcvc:AppIcon Width="36"
							  Height="36"
							  Background="Transparent"
							  AnchorVisibility="Collapsed"
							  BandVisibility="Collapsed" />

				<TextBlock Grid.Column="1"
						   Text="カウンター"
						   Style="{DynamicResource CaptionTextStyleKey}"
						   Margin="2,0,8,0" />

				<StackPanel Grid.Column="2"
							Orientation="Horizontal"
							VerticalAlignment="Top"
							WindowChrome.IsHitTestVisibleInChrome="True">
					<metro:CaptionButton Click="ScreenshotButton_Click"
									 ToolTip="ウィンドウのスクリーンショットを保存">
						<Path Data="M4,4 L4,2 C4,0.9 4.9,0 6,0 L10,0 C11.1,0 12,0.9 12,2 L12,4 L14,4 C15.1,4 16,4.9 16,6 L16,14 C16,15.1 15.1,16 14,16 L2,16 C0.9,16 0,15.1 0,14 L0,6 C0,4.9 0.9,4 2,4 z M8,13 C9.93,13 11.5,11.43 11.5,9.5 C11.5,7.57 9.93,6 8,6 C6.07,6 4.5,7.57 4.5,9.5 C4.5,11.43 6.07,13 8,13 z M8,11.5 C6.9,11.5 6,10.6 6,9.5 C6,8.4 6.9,7.5 8,7.5 C9.1,7.5 10,8.4 10,9.5 C10,10.6 9.1,11.5 8,11.5 z"
							  Width="14"
							  Stretch="Uniform"
							  Fill="{DynamicResource ForegroundBrushKey}" />
					</metro:CaptionButton>
					<metro:CaptionButton IsChecked="{Binding IsTopMost, Mode=TwoWay}"
									 ToolTip="常に最前面に表示"
									 Style="{DynamicResource PinButtonStyleKey}" />
					<metro:SystemButtons HorizontalAlignment="Right"
									 VerticalAlignment="Top" />
				</StackPanel>
			</Grid>
		</Border>
		<!-- #endregion -->

		<!-- コンテンツ: CounterView をそのまま埋め込み -->
		<counter:CounterView Grid.Row="1"
							 Margin="4" />
	</Grid>
</metro:MetroWindow>

