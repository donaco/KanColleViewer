<UserControl x:Class="Counter.CounterView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:metro2="http://schemes.grabacr.net/winfx/2015/personal/controls"
			 xmlns:wrapper="clr-namespace:Grabacr07.KanColleWrapper;assembly=KanColleWrapper"
			 xmlns:counter="clr-namespace:Counter"
			 mc:Ignorable="d"
			 d:DataContext="{d:DesignInstance counter:CounterViewModel}"
			 d:DesignHeight="400"
			 d:DesignWidth="720">
	<UserControl.Resources>
		<counter:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
		<counter:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
		<counter:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
		<counter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

		<!-- Expeditions.xaml ベースの GroupBox スタイル -->
		<Style x:Key="BaseGroupBoxStyle"
			   TargetType="{x:Type GroupBox}">
			<Setter Property="OverridesDefaultStyle"
					Value="True" />
			<Setter Property="BorderThickness"
					Value=".99" />
			<Setter Property="BorderBrush"
					Value="{DynamicResource BorderBrushKey}" />
			<Setter Property="Background"
					Value="{DynamicResource BorderBrushKey}" />
			<Setter Property="TextOptions.TextFormattingMode"
					Value="Display" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type GroupBox}">
						<Border BorderThickness="{TemplateBinding BorderThickness}"
								BorderBrush="{TemplateBinding BorderBrush}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>

								<Border Background="{TemplateBinding Background}">
									<ContentPresenter Content="{TemplateBinding Header}"
													  ContentTemplate="{TemplateBinding HeaderTemplate}"
													  ContentStringFormat="{TemplateBinding HeaderStringFormat}" />
								</Border>

								<ContentPresenter Grid.Row="1"
												  Content="{TemplateBinding Content}"
												  ContentTemplate="{TemplateBinding ContentTemplate}"
												  ContentStringFormat="{TemplateBinding ContentStringFormat}"
												  Margin="{TemplateBinding Padding}" />
							</Grid>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>

			<Setter Property="HeaderTemplate">
				<Setter.Value>
					<DataTemplate>
						<Border Margin="9,5">
							<TextBlock Text="{Binding}"
									   FontSize="{DynamicResource EmphaticFontSizeKey}"
									   Foreground="{DynamicResource ForegroundBrushKey}" />
						</Border>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 暗黙の GroupBox スタイル（全 GroupBox に自動適用） -->
		<Style TargetType="{x:Type GroupBox}"
			   BasedOn="{StaticResource BaseGroupBoxStyle}" />

		<!-- 無効時に半透明化するスタイル -->
		<Style x:Key="DisableableGroupBoxStyle"
			   TargetType="{x:Type GroupBox}"
			   BasedOn="{StaticResource BaseGroupBoxStyle}">
			<Style.Triggers>
				<Trigger Property="IsEnabled"
						 Value="False">
					<Setter Property="Opacity"
							Value="0.35" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto"
				  HorizontalScrollBarVisibility="Disabled"
				  PanningMode="Both">
		<DockPanel Margin="5,0,5,5">
			<!-- フッター注意書き -->
			<TextBlock DockPanel.Dock="Bottom"
					   Text="※アプリケーションが起動している間に発生した回数のみをカウントしています。"
					   Style="{DynamicResource DefaultTextStyleKey}"
					   Margin="10,8,10,0" />

			<!-- 3列レイアウト -->
			<UniformGrid DockPanel.Dock="Top"
						 Columns="3"
						 Margin="0,0,0,0">

				<!-- ========== 第1列: 上下2段 ========== -->
				<DockPanel Margin="5,0,5,5">

					<!-- 下段: 表示設定 -->
					<GroupBox DockPanel.Dock="Bottom"
							  Header="表示設定"
							  Margin="0,5,0,0"
							  Padding="8,8,8,8">
						<StackPanel>
							<CheckBox IsChecked="{Binding IsCounterEnabled, Mode=TwoWay}"
									  Foreground="{DynamicResource ForegroundBrushKey}"
									  Margin="0,2">
								<TextBlock Text="カウンターを記録する"
										   Style="{DynamicResource DefaultTextStyleKey}" />
							</CheckBox>
							<CheckBox IsChecked="{Binding IsSortieHistoryEnabled, Mode=TwoWay}"
									  Foreground="{DynamicResource ForegroundBrushKey}"
									  Margin="0,2">
								<TextBlock Text="戦闘履歴、出撃数を記録する"
										   Style="{DynamicResource DefaultTextStyleKey}" />
							</CheckBox>
							<CheckBox IsChecked="{Binding SortieHistory.BossOnly, Mode=TwoWay}"
									  IsEnabled="{Binding IsSortieHistoryEnabled}"
									  Foreground="{DynamicResource ForegroundBrushKey}"
									  Margin="16,2,0,2">
								<TextBlock Text="ボスマスのみを記録する"
										   Style="{DynamicResource DefaultTextStyleKey}" />
							</CheckBox>
							<CheckBox IsChecked="{Binding ShowAirSuperiority, Mode=TwoWay}"
								  IsEnabled="{Binding IsSortieHistoryEnabled}"
								  Foreground="{DynamicResource ForegroundBrushKey}"
								  Margin="0,2">
								<TextBlock Text="制空状態を表示する"
									   Style="{DynamicResource DefaultTextStyleKey}" />
							</CheckBox>

							<!-- 区切り線（ポップアップ内では非表示） -->
							<Border Height=".99"
									Background="{DynamicResource BorderBrushKey}"
									Margin="0,6"
									Visibility="{Binding IsPopupMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

							<!-- ポップアップボタン（ポップアップ内では非表示） -->
							<metro2:CallMethodButton Content="別ウィンドウで表示"
													 MethodName="OpenPopupWindow"
													 HorizontalAlignment="Stretch"
													 Margin="0,0,0,0"
													 Padding="10"
													 Visibility="{Binding IsPopupMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
						</StackPanel>
					</GroupBox>

					<!-- 上段: カウンター -->
					<GroupBox Header="カウンター"
							  Padding="8"
							  IsEnabled="{Binding IsCounterEnabled}"
							  Style="{StaticResource DisableableGroupBoxStyle}">
						<StackPanel>
							<ItemsControl ItemsSource="{Binding Counters}"
										  Grid.IsSharedSizeScope="True">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="2,2,2,6"
												Padding="0,0,0,6"
												BorderThickness="0,0,0,.99"
												BorderBrush="{DynamicResource BorderBrushKey}">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto"
																	  SharedSizeGroup="CounterText" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>

												<TextBlock>
													<Run Text="{Binding Text, Mode=OneWay}" />
													<Run Text=":" />
													<Run Text="{Binding Count}"
														 Style="{DynamicResource EmphaticTextElementStyleKey}" />
												</TextBlock>
												<metro2:CallMethodButton Grid.Column="2"
																		 Content="リセット"
																		 MethodName="Reset" />
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- カウンター直下に配置（右寄せ、横並び） -->
							<StackPanel Orientation="Horizontal"
										HorizontalAlignment="Right"
										Margin="2,2,2,0">
								<metro2:CallMethodButton Content="全リセット"
													 MethodName="ResetAllCounters"
													 Padding="2,3,2,3" />
							</StackPanel>
						</StackPanel>
					</GroupBox>
				</DockPanel>

				<!-- ========== 第2列: 直近12件の戦闘結果 ========== -->
				<GroupBox Header="戦闘履歴"
						  Margin="5,0,5,5"
						  Padding="8"
						  IsEnabled="{Binding IsSortieHistoryEnabled}"
						  Style="{StaticResource DisableableGroupBoxStyle}">
					<DockPanel>
						<!-- リセットボタンを下端に固定 -->
						<StackPanel DockPanel.Dock="Bottom"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,8,0,0"
									Visibility="{Binding SortieHistory, Converter={StaticResource NullToCollapsedConverter}}">
							<metro2:CallMethodButton Content="リセット"
													 MethodName="ResetHistory"
													 DataContext="{Binding SortieHistory}" />
						</StackPanel>

						<!-- 戦闘履歴リスト -->
						<ItemsControl ItemsSource="{Binding SortieHistory.History}"
									  Grid.IsSharedSizeScope="True">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type counter:SortieRecord}">
									<Border Margin="2,1"
											Padding="2,1">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="39"   SharedSizeGroup="ColTime" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="ColArea" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="ColRank" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="ColAir" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="ColBoss" />
											</Grid.ColumnDefinitions>

											<!-- 時刻 -->
											<TextBlock Grid.Column="0"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,6,0">
												<Run Text="{Binding Timestamp, StringFormat=HH:mm, Mode=OneWay}"
													 Foreground="{DynamicResource ForegroundBrushKey}" />
											</TextBlock>

											<!-- 海域（例: 5-5-K）-->
											<TextBlock Grid.Column="1"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,4,0">
												<Run Text="{Binding CleanAreaCellKey, Mode=OneWay}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>

											<!-- ボス表示（例: [ボス]）-->
											<TextBlock Grid.Column="2"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,0,0"
													   Visibility="{Binding BossText, Converter={StaticResource NullToCollapsedConverter}}">
												<Run Text="{Binding BossText, Mode=OneWay}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>
											<!-- 防空戦は WinRank が無いので同じ列に重ねて表示 -->
											<TextBlock Grid.Column="2"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,0,0"
													   Visibility="{Binding DestructionText, Converter={StaticResource NullToCollapsedConverter}}">
												<Run Text="{Binding DestructionText, Mode=OneWay}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>

											<!-- 戦闘結果（例: [S]）-->
											<TextBlock Grid.Column="3"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,0,0"
													   Visibility="{Binding WinRank, Converter={StaticResource NullToCollapsedConverter}}">
												<Run Text="{Binding WinRank, Mode=OneWay, StringFormat=[{0}]}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>

											<!-- 制空状態（例: [確保]）-->
											<TextBlock Grid.Column="4"
													   Margin="0,0,0,0"
													   Visibility="{Binding DataContext.ShowAirSuperiority, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}}">
												<TextBlock.Style>
													<Style TargetType="{x:Type TextBlock}">
														<Setter Property="Foreground" Value="{DynamicResource ForegroundBrushKey}" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding AirSuperiorityText}" Value="">
																<Setter Property="Visibility" Value="Collapsed" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
												<Run Text="{Binding AirSuperiorityText, Mode=OneWay}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</DockPanel>
				</GroupBox>

				<!-- ========== 第3列: 海域ごとの出撃数 ========== -->
				<GroupBox Header="海域ごとの出撃数"
						  Margin="5,0,5,5"
						  Padding="8"
						  IsEnabled="{Binding IsSortieHistoryEnabled}"
						  Style="{StaticResource DisableableGroupBoxStyle}">
					<DockPanel>
						<!-- リセットボタンを下端に固定 -->
						<StackPanel DockPanel.Dock="Bottom"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,8,0,0"
									Visibility="{Binding SortieHistory, Converter={StaticResource NullToCollapsedConverter}}">
							<metro2:CallMethodButton Content="リセット"
													 MethodName="ResetAreaCounts"
													 DataContext="{Binding SortieHistory}" />
						</StackPanel>

						<!-- 出撃数リスト -->
						<ItemsControl ItemsSource="{Binding SortieHistory.AreaCounts}"
									  Grid.IsSharedSizeScope="True">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type counter:SortieAreaCount}">
									<Border Margin="2,1"
											Padding="2,1">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" SharedSizeGroup="AcArea" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="AcBoss" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="AcCount" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="AcRank" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="AcAir" />
											</Grid.ColumnDefinitions>

											<!-- 海域（例: 6-5-E）-->
											<TextBlock Grid.Column="0"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,4,0">
												<Run Text="{Binding AreaCellKey, Mode=OneWay}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>

											<!-- ボス表示（例: [ボス]）-->
											<TextBlock Grid.Column="1"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,0,0"
													   Visibility="{Binding BossText, Converter={StaticResource NullToCollapsedConverter}}">
												<Run Text="{Binding BossText, Mode=OneWay}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>
											<!-- 防空戦表示（例: [防空]）ボスと同じ列に重ねる -->
											<TextBlock Grid.Column="1"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,0,0"
													   Visibility="{Binding DestructionText, Converter={StaticResource NullToCollapsedConverter}}">
												<Run Text="{Binding DestructionText, Mode=OneWay}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>

											<!-- 出撃数（例: :3）-->
											<TextBlock Grid.Column="2"
													   Style="{DynamicResource DefaultTextStyleKey}"
													   Margin="0,0,4,0">
												<Run Text=":"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
												<Run Text="{Binding Count, Mode=OneWay}"
													 Style="{DynamicResource EmphaticTextElementStyleKey}" />
											</TextBlock>

											<!-- 戦闘結果 S,A,B（横並び）-->
											<StackPanel Grid.Column="3"
														Orientation="Horizontal">
												<TextBlock Style="{DynamicResource DefaultTextStyleKey}"
														   Text="{Binding SText, Mode=OneWay}"
														   Margin="0,2,4,0"
														   Visibility="{Binding SCount, Converter={StaticResource CountToVisibilityConverter}}" />
												<TextBlock Style="{DynamicResource DefaultTextStyleKey}"
														   Text="{Binding AText, Mode=OneWay}"
														   Margin="0,2,4,0"
														   Visibility="{Binding ACount, Converter={StaticResource CountToVisibilityConverter}}" />
												<TextBlock Style="{DynamicResource DefaultTextStyleKey}"
														   Text="{Binding BText, Mode=OneWay}"
														   Margin="0,2,4,0"
														   Visibility="{Binding BCount, Converter={StaticResource CountToVisibilityConverter}}" />
											</StackPanel>

											<!-- 制空結果 確保,優勢（横並び）-->
											<StackPanel Grid.Column="4"
														Orientation="Horizontal">
												<TextBlock Style="{DynamicResource DefaultTextStyleKey}"
														   Text="{Binding AirSupremacyText, Mode=OneWay}"
														   Margin="0,2,4,0"
														   Visibility="{Binding AirSupremacyCount, Converter={StaticResource CountToVisibilityConverter}}" />
												<TextBlock Style="{DynamicResource DefaultTextStyleKey}"
														   Text="{Binding AirSuperiorText, Mode=OneWay}"
														   Margin="0,2,4,0"
														   Visibility="{Binding AirSuperiorCount, Converter={StaticResource CountToVisibilityConverter}}" />
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</DockPanel>
				</GroupBox>
			</UniformGrid>
		</DockPanel>
	</ScrollViewer>
</UserControl>

