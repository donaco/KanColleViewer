<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ToastNotificationManagerCompat / Show() は Windows SDK 18362 以上で有効になる -->
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Grabacr07.KanColleViewer.Plugins</RootNamespace>
    <AssemblyName>WindowsNotifier</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <ProjectGuid>{55C0036D-3206-4C63-A2C0-447C41CAFAF5}</ProjectGuid>
    <Platforms>AnyCPU;x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- NuGet パッケージの DLL を出力フォルダーへコピーする (プラグインとして単体配布するため) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Grabacr07.KanColleViewer.Composition\KanColleViewer.Composition.csproj" />
    <ProjectReference Include="..\..\Grabacr07.KanColleViewer.Controls\KanColleViewer.Controls.csproj" />
    <ProjectReference Include="..\..\Grabacr07.KanColleViewer\KanColleViewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

  <Target Name="CopyToHostPlugins" AfterTargets="Build">
    <ItemGroup>
      <_PluginFilesToCopy Include="$(TargetPath)" />
      <_PluginFilesToCopy Include="$(TargetDir)CommunityToolkit.WinUI.Notifications.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFilesToCopy)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\Grabacr07.KanColleViewer\bin\$(Platform)\$(Configuration)\Plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
