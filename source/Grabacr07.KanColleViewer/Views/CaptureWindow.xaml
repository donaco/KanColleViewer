<Window x:Class="Grabacr07.KanColleViewer.Views.CaptureWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="通信キャプチャ" Height="600" Width="900">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Margin="6">
			<Button Content="クリア" Margin="0,0,6,0" Padding="8,4" Click="Clear_Click" />
			<TextBlock VerticalAlignment="Center" Text="最新が上に表示されます" />
		</StackPanel>

		<ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Margin="6">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="6">
						<StackPanel>
							<TextBlock Text="{Binding Url}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
							<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
								<TextBlock Text="Method: " FontWeight="Bold" />
								<TextBlock Text="{Binding Method}" Margin="6,0,12,0" />
								<TextBlock Text="Status: " FontWeight="Bold" />
								<TextBlock Text="{Binding StatusCode}" Margin="6,0,12,0" />
							</StackPanel>
							<Expander Header="Request / Response" IsExpanded="False">
								<ScrollViewer VerticalScrollBarVisibility="Auto" Height="200">
									<TextBlock TextWrapping="Wrap">
										<TextBlock.Text>
											<MultiBinding StringFormat="Request:\n{0}\n\nResponse:\n{1}">
												<Binding Path="RequestBody" />
												<Binding Path="ResponseBody" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</ScrollViewer>
							</Expander>
						</StackPanel>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>
</Window>
