<UserControl x:Class="Grabacr07.KanColleViewer.Views.Settings.Network"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:metro="http://schemes.grabacr.net/winfx/2014/controls"
				 xmlns:controls="clr-namespace:Grabacr07.KanColleViewer.Views.Controls"
				 xmlns:kcvc="http://schemes.grabacr.net/winfx/2015/kancolleviewer/controls"
			 xmlns:metro2="clr-namespace:MetroTrilithon.UI.Controls;assembly=KanColleViewer.Controls"
			 xmlns:models="clr-namespace:Grabacr07.KanColleViewer.Models"
			 xmlns:ms="clr-namespace:Grabacr07.KanColleViewer.Models.Settings"
			 xmlns:vms="clr-namespace:Grabacr07.KanColleViewer.ViewModels.Settings"
			 xmlns:root="clr-namespace:Grabacr07.KanColleViewer"
			 mc:Ignorable="d"
			 d:DesignWidth="500"
			 d:DesignHeight="640"
			 d:DataContext="{d:DesignInstance vms:NetworkSettingsViewModel}">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Common.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<StackPanel>
		<TextBlock Text="{Binding Resources.Settings_Proxy, Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
				   Style="{DynamicResource SettingsHeaderTextStyleKey}" />

		<StackPanel Margin="20,0,0,0">
			<RadioButton x:Name="CheckDirectAccess"
						 GroupName="ProxySettings"
						 Content="{Binding [Ui_Proxy_Direct], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
						 IsChecked="{Binding ProxyType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DirectAccess}" />

			<TextBlock Style="{DynamicResource DetailTextStyleKey}"
					   IsEnabled="{Binding ProxyType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DirectAccess}"
					   Margin="20,2,0,0">
					<Run Text="{Binding [Ui_Proxy_Direct_Description], Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
			</TextBlock>

			<Border Height="8" />
			<RadioButton x:Name="CheckUseSystemProxy"
						 GroupName="ProxySettings"
						 Content="{Binding [Ui_Proxy_System], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
						 IsChecked="{Binding ProxyType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SystemProxy}" />

			<TextBlock Style="{DynamicResource DetailTextStyleKey}"
					   IsEnabled="{Binding ProxyType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SystemProxy}"
					   Margin="20,2,0,0">
					<Run Text="{Binding [Ui_Proxy_System_Description], Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
			</TextBlock>

			<Border Height="8" />
			<RadioButton x:Name="CheckUseSpecificProxy"
						 GroupName="ProxySettings"
						 Content="{Binding [Ui_Proxy_Specific], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
						 IsChecked="{Binding ProxyType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SpecificProxy}" />

			<StackPanel IsEnabled="{Binding ProxyType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SpecificProxy}"
						Margin="20,0,0,0"
						Grid.IsSharedSizeScope="True">
				<StackPanel.Resources>
					<Style TargetType="{x:Type controls:PromptTextBox}">
						<Setter Property="Margin"
								Value="0,3" />
					</Style>
				</StackPanel.Resources>

				<TextBlock Style="{DynamicResource DetailTextStyleKey}"
						   Margin="0,2">
						<Run Text="{Binding [Ui_Proxy_Specific_Description], Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
					<LineBreak />
						<Run Text="{Binding [Ui_Proxy_Specific_Host_Notice], Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
				</TextBlock>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"
										  SharedSizeGroup="Col0" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="15"
										  SharedSizeGroup="Col2" />
						<ColumnDefinition Width="Auto"
										  SharedSizeGroup="Col3" />
						<ColumnDefinition Width="60"
										  SharedSizeGroup="Col4" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
							   Grid.Column="0"
							   TextAlignment="Right">
						<Run Text="HTTP" />
						<Run Text=": " />
					</TextBlock>
					<controls:PromptTextBox Grid.Row="0"
										 Grid.Column="1"
										 Text="{Binding SpecificHttpProxyHost, Mode=TwoWay}"
										 Prompt="{Binding Resources.Settings_Proxy_Host, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
					<TextBlock Grid.Row="0"
							   Grid.Column="3">
						<Run Text="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
						<Run Text=": " />
					</TextBlock>
					<controls:PromptTextBox Grid.Row="0"
										 Grid.Column="4"
										 Prompt="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
										 MaxLength="5">
						<controls:PromptTextBox.Text>
							<Binding Path="SpecificHttpProxyPort"
									 UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<controls:Int32Rule Min="1"
													 Max="65535"
													 AllowsEmpty="True" />
								</Binding.ValidationRules>
							</Binding>
						</controls:PromptTextBox.Text>
					</controls:PromptTextBox>

					<CheckBox Grid.Row="1"
							  Grid.Column="1"
							  Grid.ColumnSpan="3"
							  Content="{Binding [Ui_Proxy_UseForAllProtocols], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
							  Margin="-1,4"
							  IsChecked="{Binding IsUseHttpProxyForAllProtocols, Mode=TwoWay}" />
				</Grid>

				<Grid IsEnabled="{Binding IsUseHttpProxyForAllProtocols, Converter={StaticResource ReverseBooleanConverter}}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition SharedSizeGroup="Col0" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition SharedSizeGroup="Col2" />
						<ColumnDefinition SharedSizeGroup="Col3" />
						<ColumnDefinition SharedSizeGroup="Col4" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
							   Grid.Column="0"
							   TextAlignment="Right">
						<Run Text="HTTPS" />
						<Run Text=": " />
					</TextBlock>
					<controls:PromptTextBox Grid.Row="0"
										 Grid.Column="1"
										 Text="{Binding SpecificHttpsProxyHost, Mode=TwoWay}"
										 Prompt="{Binding Resources.Settings_Proxy_Host, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
					<TextBlock Grid.Row="0"
							   Grid.Column="3">
						<Run Text="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
						<Run Text=": " />
					</TextBlock>
					<controls:PromptTextBox Grid.Row="0"
										 Grid.Column="4"
										 Prompt="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
										 MaxLength="5">
						<controls:PromptTextBox.Text>
							<Binding Path="SpecificHttpsProxyPort"
									 UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<controls:Int32Rule Min="1"
													 Max="65535"
													 AllowsEmpty="True" />
								</Binding.ValidationRules>
							</Binding>
						</controls:PromptTextBox.Text>
					</controls:PromptTextBox>

					<TextBlock Grid.Row="1"
							   Grid.Column="0"
							   TextAlignment="Right">
						<Run Text="FTP" />
						<Run Text=": " />
					</TextBlock>
					<controls:PromptTextBox Grid.Row="1"
										 Grid.Column="1"
										 Text="{Binding SpecificFtpProxyHost, Mode=TwoWay}"
										 Prompt="{Binding Resources.Settings_Proxy_Host, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
					<TextBlock Grid.Row="1"
							   Grid.Column="3">
						<Run Text="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
						<Run Text=": " />
					</TextBlock>
					<controls:PromptTextBox Grid.Row="1"
										 Grid.Column="4"
										 Prompt="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
										 MaxLength="5">
						<controls:PromptTextBox.Text>
							<Binding Path="SpecificFtpProxyPort"
									 UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<controls:Int32Rule Min="1"
													 Max="65535"
													 AllowsEmpty="True" />
								</Binding.ValidationRules>
							</Binding>
						</controls:PromptTextBox.Text>
					</controls:PromptTextBox>

					<TextBlock Grid.Row="2"
							   Grid.Column="0"
							   TextAlignment="Right">
						<Run Text="SOCKS" />
						<Run Text=": " />
					</TextBlock>
					<controls:PromptTextBox Grid.Row="2"
										 Grid.Column="1"
										 Text="{Binding SpecificSocksProxyHost, Mode=TwoWay}"
										 Prompt="{Binding Resources.Settings_Proxy_Host, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
					<TextBlock Grid.Row="2"
							   Grid.Column="3">
						<Run Text="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
						<Run Text=": " />
					</TextBlock>
					<controls:PromptTextBox Grid.Row="2"
										 Grid.Column="4"
										 Prompt="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
										 MaxLength="5">
						<controls:PromptTextBox.Text>
							<Binding Path="SpecificSocksProxyPort"
									 UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<controls:Int32Rule Min="1"
													 Max="65535"
													 AllowsEmpty="True" />
								</Binding.ValidationRules>
							</Binding>
						</controls:PromptTextBox.Text>
					</controls:PromptTextBox>
				</Grid>
			</StackPanel>

			<Border Height="8" />
			<Rectangle Style="{DynamicResource SeparatorStyleKey}" />
			<Border Height="8" />
			<CheckBox x:Name="CheckRelayEnabled"
					  Content="{Binding [Ui_Proxy_Relay_Enable], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
					  IsChecked="{Binding IsRelayEnabled, Mode=TwoWay}" />

			<TextBlock Style="{DynamicResource DetailTextStyleKey}"
					   IsEnabled="{Binding IsRelayEnabled}"
					   Margin="20,2">
				<Run Text="{Binding [Ui_Proxy_Relay_Description], Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
			</TextBlock>

			<Grid IsEnabled="{Binding IsRelayEnabled}"
				  Margin="20,4,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="15" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="60" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Column="0"
						   TextAlignment="Right"
						   VerticalAlignment="Center">
					<Run Text="{Binding [Ui_Proxy_Relay_Host], Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
					<Run Text=": " />
				</TextBlock>

				<controls:PromptTextBox Grid.Column="1"
										 Text="{Binding RelayUpstreamHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock Grid.Column="3"
						   TextAlignment="Right"
						   VerticalAlignment="Center">
						<Run Text="{Binding Resources.Settings_Proxy_Port, Source={x:Static models:ResourceService.Current}, Mode=OneWay}" />
					<Run Text=": " />
				</TextBlock>

				<controls:PromptTextBox Grid.Column="4"
										 Text="{Binding RelayUpstreamPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			</Grid>

			<Border Height="8" />
			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Right">
				<TextBlock Text="{Binding [Ui_Settings_RestartRequired], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
						   Style="{DynamicResource DetailTextStyleKey}"
						   Margin="16,8" />

				<metro2:CallMethodButton MethodTarget="{Binding}"
										 MethodName="Apply"
										 Content="{Binding [Ui_Action_Save], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
										 MinWidth="110"
										 Padding="16,6" />
				<Border Width="8" />
				<metro2:CallMethodButton MethodTarget="{Binding}"
										 MethodName="Cancel"
										 Content="{Binding [Ui_Action_Cancel], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
										 MinWidth="110"
										 Padding="16,6" />
			</StackPanel>
		</StackPanel>

		<!-- 開発者向けオプション -->
		<StackPanel IsEnabled="{Binding Source={x:Static ms:GeneralSettings.IsRemoteDebuggingEnabled}, Path=Value, Mode=OneWay}">
			<Border Height="4" />
			<Rectangle Style="{DynamicResource SeparatorStyleKey}" />
			<TextBlock Text="{Binding [Ui_Settings_DeveloperTools], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
					   Style="{DynamicResource SettingsHeaderTextStyleKey}" />

			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Right">
				<TextBlock Text="{Binding [Ui_Settings_DeveloperTools_Description], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
						   Style="{DynamicResource DetailTextStyleKey}"
						   Margin="16,8" />
				<Border Width="5" />
				<metro2:CallMethodButton MethodTarget="{Binding Source={x:Static root:WindowService.Current}}"
										 MethodName="ShowDevTools"
										 Content="{Binding [Ui_Action_Show], Source={x:Static models:ResourceService.Current}, Mode=OneWay}"
										 MinWidth="110"
										 Padding="16,6" />
			</StackPanel>
		</StackPanel>
	</StackPanel>
</UserControl>
