<UserControl x:Class="Grabacr07.KanColleViewer.Views.Settings.VersionInfo"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:livet="http://schemas.livet-mvvm.net/2011/wpf"
			 xmlns:metro="http://schemes.grabacr.net/winfx/2014/controls"
			 xmlns:metro2="clr-namespace:MetroTrilithon.UI.Controls;assembly=KanColleViewer.Controls"
			 xmlns:kcvc="http://schemes.grabacr.net/winfx/2015/kancolleviewer/controls"
			 xmlns:kcvi="http://schemes.grabacr.net/winfx/2015/kancolleviewer/interactivity"
			 xmlns:kcvv="http://schemes.grabacr.net/winfx/2015/kancolleviewer/converters"
			 xmlns:root="clr-namespace:Grabacr07.KanColleViewer"
			 xmlns:views="clr-namespace:Grabacr07.KanColleViewer.Views"
			 xmlns:viewModels="clr-namespace:Grabacr07.KanColleViewer.ViewModels"
			 xmlns:properties="clr-namespace:Grabacr07.KanColleViewer.Properties"
			 xmlns:controls="clr-namespace:Grabacr07.KanColleViewer.Views.Controls"
			 xmlns:models="clr-namespace:Grabacr07.KanColleViewer.Models"
			 xmlns:settings="clr-namespace:Grabacr07.KanColleViewer.ViewModels.Settings"
			 mc:Ignorable="d"
			 d:DesignWidth="550"
			 d:DesignHeight="300"
			 d:DataContext="{d:DesignInstance settings:SettingsViewModel}">
	<Grid Margin="8,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Grid.ColumnSpan="2"
					TextOptions.TextFormattingMode="Ideal">
			<TextBlock Text="{Binding Source={x:Static models:ProductInfo.Product}, Mode=OneWay}"
					   FontFamily="Segoe UI Light"
					   FontSize="44"
					   Foreground="{DynamicResource ActiveForegroundBrushKey}"
					   Margin="-3,-14,0,0" />
			<TextBlock Text="tool of the admiral, by the admiral, for the admiral"
					   FontFamily="Segoe UI Light"
					   FontSize="16"
					   Margin="0,-9,0,0" />
			<TextBlock Margin="-1,0,0,-4">
				<Run Text="{Binding Source={x:Static models:ProductInfo.Title}, Mode=OneWay}"
					 FontFamily="Yu Gothic Light"
					 FontSize="20"
					 Foreground="{DynamicResource ActiveForegroundBrushKey}" />
				<Run Text="  " />
				<Run Text="{Binding Source={x:Static models:ProductInfo.VersionString}, StringFormat=Version {0}, Mode=OneWay}"
					 FontFamily="Segoe UI Light"
					 FontSize="20"
					 Foreground="{DynamicResource ActiveForegroundBrushKey}" />
			</TextBlock>

			<Rectangle Height=".99"
					   Margin="0,10"
					   Style="{DynamicResource SeparatorRectangleStyleKey}" />

			<TextBlock FontFamily="Segoe UI">
				<Run Text="Project home:" />
				<metro2:HyperlinkEx Uri="https://github.com/donaco/KanColleViewer">
					<Run Text="https://github.com/donaco/KanColleViewer" />
				</metro2:HyperlinkEx>

				<LineBreak />

				<Run Text="Source code:" />
				<metro2:HyperlinkEx Uri="https://github.com/donaco/KanColleViewer">
					<Run Text="https://github.com/donaco/KanColleViewer" />
				</metro2:HyperlinkEx>

				<LineBreak />

				<Run Text="Author:" />
				<metro2:HyperlinkEx Uri="https://x.com/Grabacr07">
					<Run Text="@Grabacr07" />
				</metro2:HyperlinkEx>

				<LineBreak />
				<LineBreak />

				<Run Text="Developer:" />
				<metro2:HyperlinkEx Uri="https://x.com/Grabacr07">
					<Run Text="@Grabacr07" />
				</metro2:HyperlinkEx>
				<metro2:HyperlinkEx Uri="https://x.com/veigr">
					<Run Text="@veigr" />
				</metro2:HyperlinkEx>
				<metro2:HyperlinkEx Uri="https://x.com/d_kancolle">
					<Run Text="@donaco" />
				</metro2:HyperlinkEx>

				<LineBreak />

				<Run Text="Icon design:" />
				<metro2:HyperlinkEx Uri="https://x.com/Nrtwd/">
					<Run Text="@Nrtwd" />
				</metro2:HyperlinkEx>
			</TextBlock>

			<Rectangle Height=".99"
					   Margin="0,10"
					   Style="{DynamicResource SeparatorRectangleStyleKey}" />
		</StackPanel>
		
		<StackPanel Grid.Row="1"
					Grid.Column="0">
			<!-- Phase 4: metro:BindableTextBlock / metro:InlineHolder を ItemsControl で代替 -->
			<ItemsControl ItemsSource="{Binding Libraries}"
						  FontFamily="Segoe UI"
						  FontSize="11">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.Resources>
					<DataTemplate DataType="{x:Type settings:HyperlinkViewModel}">
						<TextBlock Margin="0,1,4,1">
							<metro2:HyperlinkEx Uri="{Binding Uri}">
								<Run Text="{Binding Text, Mode=OneWay}" />
							</metro2:HyperlinkEx>
						</TextBlock>
					</DataTemplate>
					<DataTemplate DataType="{x:Type settings:BindableTextViewModel}">
						<TextBlock Text="{Binding Text, Mode=OneWay}"
								   Foreground="{DynamicResource ActiveForegroundBrushKey}"
								   Margin="0,1,4,1" />
					</DataTemplate>
				</ItemsControl.Resources>
			</ItemsControl>
			
			<StackPanel Orientation="Horizontal"
						Margin="0,10,0,0">
				<Button Content="アップデートチェック"
						Command="{Binding CheckForUpdateCommand}"
						Padding="8,4"
						FontSize="12" />
				<!-- 通常ステータス (最新版です / 確認中... / 確認に失敗しました) -->
				<TextBlock Text="{Binding UpdateStatusText}"
						   VerticalAlignment="Center"
						   Margin="8,0,0,0"
						   FontSize="12"
						   Visibility="{Binding IsUpdateAvailable, Converter={StaticResource UniversalBooleanToVisibilityConverter}, ConverterParameter='Collapsed:Visible'}" />
				<!-- 更新あり (クリックでリリースページへ) -->
				<TextBlock VerticalAlignment="Center"
						   Margin="8,0,0,0"
						   FontSize="12"
						   Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
					<metro2:HyperlinkEx Uri="{Binding UpdateUri}">
						<Run Text="{Binding UpdateStatusText, Mode=OneWay}" />
					</metro2:HyperlinkEx>
				</TextBlock>
			</StackPanel>
		</StackPanel>

		<TextBlock Grid.Row="1"
				   Grid.Column="0"
				   FontFamily="Segoe UI"
				   VerticalAlignment="Bottom"
				   Margin="0,0,0,16"
				   TextWrapping="Wrap">
			<Run Text="{Binding Source={x:Static models:ProductInfo.Copyright}, Mode=OneWay}" />
			<LineBreak />
			<Run Text="Copyright © 2025 - 2026 Donaco" />
			<LineBreak />
			<Run Text="{Binding Source={x:Static models:ProductInfo.Product}, Mode=OneWay}" />
			<Run Text="is" />
			<Run Text="OSS"
				 ToolTip="Open Source Software" />
			<Run Text="released under" />
			<metro2:HyperlinkEx Uri="https://github.com/Grabacr07/KanColleViewer/blob/develop/LICENSE.txt">
				<Run Text="The MIT License." />
			</metro2:HyperlinkEx>
		</TextBlock>

		<Border Grid.Row="1"
				Grid.Column="1"
				Width="210"
				Height="210"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Background="{DynamicResource ThemeBrushKey}"
				BorderBrush="{DynamicResource HighlightBorderBrushKey}"
				BorderThickness="1"
				CornerRadius="8"
				Margin="16,0,0,0">
			<StackPanel VerticalAlignment="Center"
					HorizontalAlignment="Center">
				<TextBlock Text="KCV"
						   FontFamily="Segoe UI Light"
						   FontSize="44"
						   HorizontalAlignment="Center"
						   Foreground="{DynamicResource ActiveForegroundBrushKey}" />
				<TextBlock Text="Version"
						   Margin="0,4,0,0"
						   FontSize="14"
						   HorizontalAlignment="Center"
						   Foreground="{DynamicResource ActiveForegroundBrushKey}" />
				<TextBlock Text="{Binding Source={x:Static models:ProductInfo.VersionString}, StringFormat=v{0}, Mode=OneWay}"
						   Margin="0,2,0,0"
						   FontSize="16"
						   HorizontalAlignment="Center"
						   Foreground="{DynamicResource ActiveForegroundBrushKey}" />
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
