<UserControl x:Class="Grabacr07.KanColleViewer.Views.Contents.StateDetailIndicator"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
			 xmlns:kcvc="http://schemes.grabacr.net/winfx/2015/kancolleviewer/controls"
			 xmlns:kcvi="http://schemes.grabacr.net/winfx/2015/kancolleviewer/interactivity"
			 xmlns:kcvv="http://schemes.grabacr.net/winfx/2015/kancolleviewer/converters"
			 xmlns:models="clr-namespace:Grabacr07.KanColleViewer.Models"
			 xmlns:ms="clr-namespace:Grabacr07.KanColleViewer.Models.Settings"
			 xmlns:vm="clr-namespace:Grabacr07.KanColleViewer.ViewModels"
			 xmlns:fleets="clr-namespace:Grabacr07.KanColleViewer.ViewModels.Contents.Fleets"
			 mc:Ignorable="d"
			 d:DesignWidth="300"
			 d:DesignHeight="30"
			 d:DataContext="{d:DesignInstance fleets:FleetViewModel}">

	<UserControl.Resources>
		<kcvv:HasFlagConverter x:Key="HasFlagConverter" />
	</UserControl.Resources>

	<ContentControl Content="{Binding QuickStateView}">
		<ContentControl.Resources>
			<DataTemplate DataType="{x:Type fleets:HomeportViewModel}">
				<Grid>
					<Border x:Name="Border"
							Background="#FF5A4020"
							Padding="8,4">
						<TextBlock x:Name="Text"
								   Style="{DynamicResource DefaultTextStyleKey}"
								   Foreground="{DynamicResource ActiveForegroundBrushKey}">
							<TextBlock.Text>
								<MultiBinding StringFormat="疲労回復まで: {0}">
									<Binding Path="Condition.Remaining" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</Border>
				</Grid>

				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding Condition.IsRejuvenating}"
								 Value="False">
						<Setter TargetName="Text"
								Property="Text"
								Value="疲労回復済み" />
					</DataTrigger>
					<DataTrigger Binding="{Binding State.IsReady}"
								 Value="True">
						<Setter TargetName="Border"
								Property="Background"
								Value="#FF286414" />
						<Setter TargetName="Text"
								Property="Text"
								Value="出撃可能！" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>

			<DataTemplate DataType="{x:Type fleets:SortieViewModel}">
				<Grid>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroup x:Name="VisualStateGroup">
							<VisualState x:Name="Normal">
								<Storyboard>
									<ColorAnimationUsingKeyFrames Storyboard.TargetName="Border"
																  Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
										<EasingColorKeyFrame KeyTime="0"
															 Value="#FF5A2020" />
									</ColorAnimationUsingKeyFrames>
								</Storyboard>
							</VisualState>
							<VisualState x:Name="Blinking">
								<Storyboard AutoReverse="True"
											RepeatBehavior="Forever">
									<ColorAnimationUsingKeyFrames Storyboard.TargetName="Border"
																  Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
										<EasingColorKeyFrame KeyTime="0"
															 Value="{DynamicResource ThemeColorKey}" />
										<EasingColorKeyFrame KeyTime="0:0:0.3"
															 Value="#FFB40000" />
									</ColorAnimationUsingKeyFrames>
									<ObjectAnimationUsingKeyFrames Storyboard.TargetName="WarningText"
																   Storyboard.TargetProperty="Text">
										<DiscreteObjectKeyFrame KeyTime="0"
																Value="大破した艦娘がいます！！！" />
									</ObjectAnimationUsingKeyFrames>
								</Storyboard>
							</VisualState>
						</VisualStateGroup>
					</VisualStateManager.VisualStateGroups>

					<Border x:Name="Border"
							Background="Transparent"
							Padding="8,4">
						<StackPanel Orientation="Horizontal">
							<TextBlock x:Name="WarningText"
									   Text="艦隊は出撃中です！"
									   Style="{DynamicResource DefaultTextStyleKey}"
									   Foreground="{DynamicResource ActiveForegroundBrushKey}">
								<i:Interaction.Behaviors>
									<i:DataStateBehavior Binding="{Binding State.Situation, Converter={StaticResource HasFlagConverter}, ConverterParameter=Sortie|HeavilyDamaged}"
														  Value="True"
														  TrueState="Blinking"
														  FalseState="Normal" />
								</i:Interaction.Behaviors>
								<i:Interaction.Triggers>
									<i:EventTrigger EventName="Loaded">
										<i:Interaction.Behaviors>
											<i:ConditionBehavior>
												<i:ConditionalExpression>
													<i:ComparisonCondition LeftOperand="{Binding State.Situation, Converter={StaticResource HasFlagConverter}, ConverterParameter=Sortie|HeavilyDamaged}"
																			RightOperand="True"
																			Operator="Equal" />
												</i:ConditionalExpression>
											</i:ConditionBehavior>
										</i:Interaction.Behaviors>
										<i:GoToStateAction StateName="Blinking" />
									</i:EventTrigger>
									<i:EventTrigger EventName="Loaded">
										<i:Interaction.Behaviors>
											<i:ConditionBehavior>
												<i:ConditionalExpression>
													<i:ComparisonCondition LeftOperand="{Binding State.Situation, Converter={StaticResource HasFlagConverter}, ConverterParameter=Sortie|HeavilyDamaged}"
																			RightOperand="True"
																			Operator="NotEqual" />
												</i:ConditionalExpression>
											</i:ConditionBehavior>
										</i:Interaction.Behaviors>
										<i:GoToStateAction StateName="Normal" />
									</i:EventTrigger>
								</i:Interaction.Triggers>
							</TextBlock>
							<!-- マップ位置表示（設定で表示/非表示を切り替え） -->
							<TextBlock x:Name="SortieInfoText"
									   Text="{Binding SortieInfo.DisplayText, FallbackValue=''}"
									   Foreground="{DynamicResource ActiveForegroundBrushKey}"
									   Margin="8,0,0,0">
								<TextBlock.Style>
									<Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextStyleKey}">
										<Setter Property="Visibility" Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding SortieInfo.IsActive}" Value="False">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
											<DataTrigger Binding="{Binding Source={x:Static ms:KanColleSettings.ShowSortieInfo}, Path=Value}" Value="False">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</StackPanel>
					</Border>
				</Grid>
			</DataTemplate>

			<DataTemplate DataType="{x:Type fleets:ExpeditionViewModel}">
				<Border Padding="8,4"
						Background="#FF204080">
					<TextBlock Style="{DynamicResource DefaultTextStyleKey}"
							   Foreground="{DynamicResource ActiveForegroundBrushKey}">
						<Run Text="遠征中" />
						<Run Text=":" />
						<Run Text="{Binding Mission.Title, Mode=OneWay}" />
						<Run Text="-" />
						<Run Text="{Binding Remaining, Mode=OneWay}" />
					</TextBlock>
				</Border>
			</DataTemplate>

			<DataTemplate DataType="{x:Type vm:NullViewModel}">
				<Border Padding="8,4"
						Background="#FF3E3E42">
					<TextBlock Text="艦隊に艦娘が編成されていません。"
							   Style="{DynamicResource DefaultTextStyleKey}"
							   Foreground="{DynamicResource ActiveForegroundBrushKey}" />
				</Border>
			</DataTemplate>
		</ContentControl.Resources>
	</ContentControl>
</UserControl>
